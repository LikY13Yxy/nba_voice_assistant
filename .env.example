# NBA智能语音助手 - 环境变量配置

# ============================================
# LLM 配置 (必填)
# ============================================

# LLM 提供商选择: deepseek, openai, ollama
LLM_PROVIDER=deepseek

# DeepSeek API 配置
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MODEL=deepseek-reasoner  # 更强的推理模型

# OpenAI 兼容配置 (硅基流动等)
# 获取地址: https://cloud.siliconflow.cn/
OPENAI_API_KEY=your_siliconflow_api_key_here
OPENAI_MODEL=deepseek-ai/DeepSeek-V3
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# Ollama 本地模型配置 (备用)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# ============================================
# NBA 数据 API 配置 (可选)
# ============================================

# BallDontLie API (免费)
# 获取地址: https://www.balldontlie.io/
BALLDONTLIE_API_KEY=c433c2b4-24c0-4ecb-a980-7a4568944a26

# RapidAPI NBA API (可选，有免费额度)
# 获取地址: https://rapidapi.com/api-sports/api/nba-api-free-data
NBA_API_KEY=your_rapidapi_key_here

# 是否使用实时数据
USE_LIVE_DATA=true

# ============================================
# 应用配置 (可选)
# ============================================

# Web 服务配置
WEB_HOST=0.0.0.0
WEB_PORT=8080

# 缓存时间 (秒)
CACHE_TTL=1800
